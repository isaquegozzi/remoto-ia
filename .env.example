# Host local
REMOTO_PORT=8081
# Gere um token longo. Se vazio, o host cria um automaticamente e mostra no terminal.
REMOTO_PAIRING_TOKEN=
# Origens permitidas para acesso DIRETO ao host local, separadas por vírgula.
REMOTO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Relay opcional para acessar o PC fora da rede local.
# Ex.: wss://seu-relay.exemplo.com
REMOTO_RELAY_URL=
REMOTO_HOST_ID=

# Relay server (no servidor público)
PORT=8787
